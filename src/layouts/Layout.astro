---
import '~/assets/style/global.scss';
import '~/assets/style/scrollbar.scss';
import '~/assets/style/rainbow.scss';

import { TITLE } from '~/utils/constant';

import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="对，我就知道，其实MADAO早就开花了！">
    <meta name="author" content="Caisr">
    <title>{title ?? TITLE}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@callmebill/lxgw-wenkai-web@latest/lxgwwenkaimono-regular/result.css">
  </head>
  <body class="flex flex-col min-h-[100vh] bg-black scrollbar rainbow px-4 xl:px-0">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

