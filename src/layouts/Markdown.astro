---
import type { MarkdownFrontmatter } from '~/types/markdown';

import { Image } from 'astro:assets';
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import "github-markdown-css/github-markdown-dark.css";

import Layout from "~/layouts/Layout.astro";
import "~/assets/style/markdown.scss";

type Props = { frontmatter: MarkdownFrontmatter };

const { frontmatter } = Astro.props;

dayjs.extend(utc);

const noteMetaInfo = [
  { title: 'author', content: frontmatter.author },
  { title: 'created_at', content: dayjs(frontmatter.birthtime).format("YYYY-MM-DD HH:mm:ss") },
  { title: 'updated_at', content: dayjs(frontmatter.lastModified).format("YYYY-MM-DD HH:mm:ss") }
];
---
<Layout title={frontmatter.title}>
  <main class="mx-auto xl:w-main text-theme-white">
    <div class="flex flex-col items-stretch mb-8 xl:flex-row">
      <div class="flex flex-col flex-1 justify-between mr-4 mb-16 xl:mb-0">
        <!-- 为了让table的宽度不撑满父元素 -->
        <div class="inline-block mb-16">
          <table class="rainbow-text">
            <tbody>
              {noteMetaInfo.map(meta => (
                <tr>
                  <td class="py-2 pr-4 font-bold">{meta.title}</td>
                  <td class="py-2">{meta.content}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div>
          <h1 class="mb-8 text-4xl">{frontmatter.title}</h1>
          <p>{frontmatter.subtitle}</p>
        </div>
      </div>

      <div class="xl:max-w-[60%]">
        <Image src={frontmatter.cover.image} alt="notes cover" class="object-cover max-h-[80vh] mb-8 w-full black" />
        <a href={frontmatter.cover.sourceUrl} class="text-base text-gray-400 underline">
          <i>Image courtesy of {frontmatter.cover.source}</i>
        </a>
      </div>
    </div>
    <article class="p-8 markdown-body">
      <slot />
    </article>
  </main>
</Layout>
