---
import { Image } from "astro:assets";

import Layout from "~/layouts/Layout.astro";
import FeatureCard from "~/components/FeatureCard.astro";
import HomeCard from "~/components/HomeCard.astro";

import monsterIcon from "~/assets/images/loch-ness-monster.png";
import unicornIcon from "~/assets/images/unicorn.png";
import frogIcon from "~/assets/images/frog.png";
import post1 from "~/assets/images/poster-1.jpg";
import post2 from "~/assets/images/poster-2.jpg";
---

<Layout>
  <div class="glass-block">
    <h1
      class="h-[280px] animate-focus-in-contract-bck text-center text-6xl font-bold leading-[280px]"
    >
      👋 Hi, I'm Caisr
    </h1>
  </div>

  <div class="glass-block mt-8 flex">
    <FeatureCard
      class="h-[280px] flex-1"
      title="noun."
      description="Front-end developer, Otaku"
      icon={monsterIcon.src}
    />
    <FeatureCard
      class="h-[280px] flex-1 border-l border-r"
      title="adj."
      description="Curious, Cautious, Attention To Detail"
      icon={unicornIcon.src}
    />
    <FeatureCard
      class="h-[280px] flex-1"
      title="verb."
      description="Reflect, Absorb, Breakthrough"
      icon={frogIcon.src}
    />
  </div>

  <HomeCard
    className="bg-gradient-to-br from-[#1C512C] to-[#95B579]"
    title="教练，我想学 Three.js！"
    description="零图形知识的前端学习 Three.js 的笔记"
    labels={['Three.js', 'WebGL']}
    link="/notes/threejs"
    imgInfo={{
      src: post1,
      alt: 'Three.js Poster Image'
    }}
  />

  <HomeCard
    className="bg-gradient-to-br from-[#3F0A4F] to-[#0C3668]"
    title="Hello, Web3!"
    description="没想到程序员也是吃青春饭的职业，我想要当数字游民！"
    labels={['Web3', 'blockchain', 'Solidity', 'Ethereum', 'DeFi', 'GameFi']}
    link="/notes/web3"
    imgInfo={{
      src: post2,
      alt: 'Web3 Poster Image',
      position: 'left'
    }}
  />
</Layout>
