---
import type { MarkdownInstance } from '~/types/markdown';

import Layout from "~/layouts/Layout.astro";
import { NOTES_TYPE } from '~/utils/constant';

export function getStaticPaths() {
  const paths = NOTES_TYPE.map(item => ({ params: { slug: item } }));

  return paths;
}

const { slug } = Astro.params;

const allNotes = Object.values(import.meta.glob<MarkdownInstance>('./**/*.md', { eager: true }));
const currentNotes = allNotes.filter(note => note.frontmatter.type === slug);

---

<Layout>
  <div class="mx-auto w-main text-theme-white">
    <ol>
      {currentNotes.map(note => (
        <li class="relative py-8 cursor-pointer">
          <h3 class="mb-4 text-2xl">{note.frontmatter.title}</h3>
          <p class="text-base">{note.frontmatter.description}</p>

          <div class="absolute bottom-0 left-0 right-0 rainbow-border h-[2px]" />
        </li>
      ))}
    </ol>
  </div>
</Layout>