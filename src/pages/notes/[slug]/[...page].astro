---
import type { GetStaticPaths } from 'astro';
import type { MarkdownInstance, MarkdownFrontmatter } from '~/types/markdown';

import { getCollection } from 'astro:content';
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

import Layout from "~/layouts/Layout.astro";
import { NOTES_TYPE } from '~/utils/constant';

type Notes = Array<{id: string; collection: string;} & MarkdownFrontmatter>

dayjs.extend(utc);

export const getStaticPaths: GetStaticPaths = ({ paginate }) => {
  const allNotes = Object.values(import.meta.glob('~/data/notes/**/*.md', { eager: true })) as Array<MarkdownInstance>;

  return NOTES_TYPE.flatMap((slug) => {
    const filteredNotes = allNotes.filter((note) => note.frontmatter.type === (slug as unknown as typeof NOTES_TYPE[number]));

    return paginate(filteredNotes, {
      params: { slug },
      pageSize: 15,
    });
  });
};

const { slug } = Astro.params;


const notes = (await getCollection(slug as typeof NOTES_TYPE[number]))
  .map(note => ({
    id: note.id,
    collection: note.collection,
    ...note.rendered!.metadata!.frontmatter as unknown as MarkdownFrontmatter
  }))
  .sort((a, b) => dayjs(a.birthtime).millisecond() - dayjs(b.birthtime).millisecond()) as unknown as Notes
;
---

<Layout>
  <div class="mx-auto xl:w-main text-theme-white">
    <ol>
      {notes.map(note => (
        <li class="relative py-8 mb-8">
          <a href=`/notes/${note.collection}/details/${note.id}` class="cursor-pointer">
            <h3 class="mb-4 text-2xl">{note.title}</h3>
            <p class="text-base italic">{note.subtitle}</p>

            <div class="absolute bottom-0 left-0 right-0 rainbow-border-dashed h-[2px]" />
          </a>
        </li>
      ))}
    </ol>
  </div>
</Layout>