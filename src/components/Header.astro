---
import Navigation from './Navigation.astro';

import { TITLE } from '~/utils/constant';

const title: string[] = [TITLE.substring(0, 2), TITLE.substring(2)];
---

<header class="sticky top-0 left-0 right-0 z-50 py-8 bg-theme-black">
  <div class="flex justify-between mx-auto align-top w-main bg-theme-black">
    <h1 class="text-4xl font-normal text-theme-white text">
      {title[0]}<br />{title[1]}
    </h1>

    <Navigation />
  </div>
</header>