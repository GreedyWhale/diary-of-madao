---
import clsx from "clsx";

interface Props {
  classNames?: Partial<{
    container: string;
  }>;
}

const { classNames } = Astro.props;
---

<div class={clsx("p-8 relative overflow-hidden cursor-pointer text-theme-white rounded-xl bg-theme-black/70", classNames?.container)}>
  <div class="absolute inset-0 backdrop-blur-sm"></div>
  <slot />
</div>
